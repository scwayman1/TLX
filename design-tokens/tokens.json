  "typography": {
    "display": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "fontSize": {
          "value": 2,
          "unit": "rem"
        },
        "fontWeight": 720,
        "letterSpacing": {
          "value": -0.025,
          "unit": "em"
        }
      }
    },
    "heading-lg": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "fontSize": {
          "value": 1.5,
          "unit": "rem"
        },
        "fontWeight": 700,
        "letterSpacing": {
          "value": -0.015,
          "unit": "em"
        }
      }
    },
    "heading-md": {
