      "$value": {
        "fontFamily": "Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "fontSize": {
          "value": 1.125,
          "unit": "rem"
        },
        "fontWeight": 700
      }
    },
    "body": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "fontSize": {
          "value": 0.9375,
          "unit": "rem"
        },
        "fontWeight": 450
      }
    },
    "body-sm": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "fontSize": {
          "value": 0.8125,
          "unit": "rem"
        },
        "fontWeight": 450
      }
    },
    "label": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 680,
        "letterSpacing": {
          "value": 0.055,
          "unit": "em"
        }
      }
    },
    "numeric": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Segoe UI Variable, Segoe UI, system-ui, sans-serif",
        "fontSize": {
          "value": 1.75,
          "unit": "rem"
        },
        "fontWeight": 720,
        "letterSpacing": {
          "value": -0.03,
          "unit": "em"
        }
      }
    },
    "code": {
      "$type": "typography",
      "$value": {
        "fontFamily": "Cascadia Mono, SFMono-Regular, Consolas, monospace",
        "fontSize": {
          "value": 0.75,
          "unit": "rem"
        },
        "fontWeight": 600
      }
    }
  },
  "$extensions": {
    "telemetryx": {
      "typography": {
        "label-text-transform": "uppercase",
        "numeric-font-variant": "tabular-nums lining-nums"
      },
      "elevation": {
        "level-1": "0 1px 2px rgb(23 35 29 / 0.06)",
        "level-2": "0 8px 24px rgb(23 35 29 / 0.12)",
        "level-3": "0 18px 48px rgb(23 35 29 / 0.18)"
      },
      "motion": {
        "duration-fast": "120ms",
        "duration-spatial": "180ms",
        "ease-out": "cubic-bezier(0.2, 0, 0, 1)"
      }
    }
  }
