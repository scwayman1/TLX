{
  "name": "tlx",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "design:lint": "node node_modules/@google/design.md/dist/index.js lint --format json DESIGN.md",
    "design:generate": "node scripts/generate-design-tokens.mjs",
    "design:tokens": "npm run design:generate",
    "design:check": "node scripts/generate-design-tokens.mjs --check",
    "design:audit": "node scripts/design-literal-audit.mjs",
    "safety:source": "node scripts/source-safety-scan.mjs",
    "verify:browser": "node scripts/cdp-visual-verify.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "date-fns": "^4.4.0",
    "lucide-react": "^1.33.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@google/design.md": "0.4.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^30.0.1",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
